# کپی کنید به نام `.env` در ریشه پروژه (همان کنار package.json)
# در phpMyAdmin یک دیتابیس بسازید، مثلاً mana_site، سپس نام را در آخر URL بگذارید.
#
# XAMPP پیش‌فرض: کاربر root، رمز خالی، پورت 3306
DATABASE_URL="mysql://root:@localhost:3306/mana_site"

# اگر برای root رمز گذاشته‌اید:
# DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/mana_site"

# برای امضای JWT (در محیط واقعی مقدار طولانی و تصادفی بگذارید)
JWT_SECRET="تغییر_بدهید_به_یک_رشته_طولانی_تصادفی"

# وبلاگ: برای نصب تازه database/blog_posts.sql (شامل دسته‌ها و ستون‌های کاور/سئو).
# اگر قبلاً فقط blog_posts قدیمی دارید: database/migration_blog_v3.sql را یک‌بار اجرا کنید.
